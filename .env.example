# Copy this file to .env and fill in credentials locally. Never commit .env.
# Cloudflare Workers AI (optional if using fal.ai)
Account_ID=
Your_API_Token=

# fal.ai generation API key (FAI_AI is also supported as an alias)
FAL_KEY=
# Optional separate key for usage/billing reconciliation
FAL_ADMIN_KEY=

# Optional Telegram form-review bot
TELEGRAM_REVIEW_BOT_TOKEN=
